# KaamWala Environment Configuration
# Copy this file to .env and fill in your values
# Run with: flutter run --dart-define-from-file=.env

# Supabase (REQUIRED for production)
# Get these from Supabase Dashboard > Project Settings > API
KW_SUPABASE_URL=
KW_SUPABASE_ANON_KEY=

# Razorpay (REQUIRED for payments)
# Get these from Razorpay Dashboard > Settings > API Keys
KW_RAZORPAY_KEY_ID=

# SMS/OTP Configuration
# Set to "mock" for development without real SMS API
# Set to "msg91", "twilio", etc. for production
KW_SMS_PROVIDER=mock

# SMS Provider API Key (optional - only needed if KW_SMS_PROVIDER != mock)
KW_SMS_API_KEY=

# SMS Sender ID (optional - e.g., "KMWALA" for MSG91)
KW_SMS_SENDER_ID=

# Enable demo OTP mode (shows OTP in console/UI for testing)
# Set to "false" in production
KW_ENABLE_DEMO_OTP=true

# Optional: Cloudflare proxy base URL (Phase 4 feature, unused currently)
# KW_PROXY_BASE_URL=