# KaamWala v2 - Environment template (Phase 4 section 8)
# Copy to .env and pass via --dart-define-from-file=.env

# PUBLIC - safe to embed in the app (protected by RLS)
KW_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
KW_SUPABASE_ANON_KEY=your-anon-key

# PUBLIC - Razorpay Key ID (checkout only; Secret stays server-side)
KW_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# OPTIONAL - Cloudflare proxy domain that fronts Supabase (bypasses ISP DNS blocks)
# Leave empty during development to talk to Supabase directly.
KW_PROXY_BASE_URL=

# Run with:
# flutter run --dart-define-from-file=.env
#
# NEVER put these in the app (they live ONLY in Supabase Edge Functions):
#   RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
#   SUPABASE_SERVICE_ROLE_KEY, FCM_SERVER_KEY
