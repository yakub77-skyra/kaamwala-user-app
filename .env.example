# KaamWala v2 - Environment template (Phase 4 section 8)
# Copy to .env and pass via --dart-define-from-file=.env

# PUBLIC - safe to embed in the app (protected by RLS)
KW_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
KW_SUPABASE_ANON_KEY=your-anon-key

# PUBLIC - Razorpay Key ID (checkout only; Secret stays server-side)
KW_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# SMS / OTP - the app runs FULLY in mock mode without any real key.
# KW_SMS_PROVIDER=mock        (default; 'msg91'/'twilio' later)
# KW_SMS_API_KEY=             (leave empty in dev)
# KW_SMS_SENDER_ID=           (leave empty in dev)
# KW_ENABLE_DEMO_OTP=true     (false only once a real provider is wired up)
# Note: with KW_ENABLE_DEMO_OTP=true (or no API key) the in-app
# MockSmsGateway is used and the OTP is shown on screen / in console.

# PAYMENTS (Phase 2) - mock by default, no real keys needed.
# KW_PAYMENT_PROVIDER=mock    (default; 'razorpay' when going live)
# KW_ENABLE_DEMO_PAYMENT=true (false only in production with real keys)
# NOTE: the AUTHORITATIVE mock/real decision is server-side: create-order
# creates a real Razorpay order only when RZP_KEY_ID/KEY_SECRET are set on
# the Edge Function. The booking's payment_provider records that choice and
# mock_confirm is rejected for razorpay bookings. This env only drives the
# client demo badge/UX.

# OPTIONAL - Cloudflare proxy domain that fronts Supabase (bypasses ISP DNS blocks)
# Leave empty during development to talk to Supabase directly.
KW_PROXY_BASE_URL=

# Run with:
# flutter run --dart-define-from-file=.env
#
# NEVER put these in the app (they live ONLY in Supabase Edge Functions):
#   RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
#   SUPABASE_SERVICE_ROLE_KEY, FCM_SERVER_KEY
